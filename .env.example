# Django Settings
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=tu-secret-key-super-segura-cambiar-en-produccion
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=sqlite:///db.sqlite3
# Para PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/dream_inter

# Interledger/Open Payments
INTERLEDGER_WALLET_URL=https://ilp.interledger-test.dev/tu-wallet
INTERLEDGER_KEY_ID=tu-key-id
# El archivo private.key debe estar en infrastructure/external_services/node_microservice/

# Node Microservice
NODE_SERVICE_URL=http://localhost:3000

# Email (opcional por ahora)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=tu-password

# Security
SESSION_COOKIE_SECURE=False  # True en producción con HTTPS
CSRF_COOKIE_SECURE=False     # True en producción con HTTPS
